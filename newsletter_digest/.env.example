# OpenRouter API key (required). Create one at https://openrouter.ai/keys
OPENROUTER_API_KEY=
# OpenAI-compatible base URL used for all chat models
OPENAI_API_BASE=https://openrouter.ai/api/v1
# Model for the main (ranking) agent
NEWSLETTER_MODEL=anthropic/claude-sonnet-4.5
# Cheaper model for the per-email reader subagents (defaults to NEWSLETTER_MODEL)
NEWSLETTER_READER_MODEL=
# Gmail label that holds the newsletters
NEWSLETTER_LABEL=Newsletters
# Command used to launch the Gmail MCP server
GMAIL_MCP_COMMAND=npx
# Arguments for the Gmail MCP server command (shell-style quoting).
# The version is pinned on purpose: this server holds broad Gmail OAuth access.
# Upgrading means re-verifying its tool names and output formats (see README).
GMAIL_MCP_ARGS=@gongrzhe/server-gmail-autoauth-mcp@1.1.11

# --- Article fetching (optional, off by default) ---
# Every line below is commented out, so copying this file to .env changes nothing.
# Fetch and summarise linked article pages (true/false); same as --fetch-articles
# NEWSLETTER_FETCH_ARTICLES=false
# Max pages fetched per run, 1..50; same as --max-fetch
# NEWSLETTER_MAX_FETCH=15
# Total timeout per page request in seconds, 1..120
# NEWSLETTER_FETCH_TIMEOUT=15
# Connect timeout in seconds, 0.5..NEWSLETTER_FETCH_TIMEOUT
# NEWSLETTER_FETCH_CONNECT_TIMEOUT=5
# Max redirects followed per page, 0..10
# NEWSLETTER_FETCH_MAX_REDIRECTS=5
# Max response size in bytes, 65536 (64 KiB)..20971520 (20 MiB)
# NEWSLETTER_FETCH_MAX_BYTES=2097152
# Max extracted page text characters sent to the model, 1000..100000
# NEWSLETTER_FETCH_MAX_CHARS=20000
# Parallel page downloads, 1..16
# NEWSLETTER_FETCH_CONCURRENCY=4
# Parallel article-summary model calls, 1..8
# NEWSLETTER_FETCH_LLM_CONCURRENCY=2
# Min seconds between article-summary call starts, 0..60. Blank = default:
# 3.1 when the reader model ends with ':free' (OpenRouter free tier), else 0
# NEWSLETTER_FETCH_LLM_INTERVAL=

# --- Telegram delivery (optional, off by default) ---
# Every line below is commented out, so copying this file to .env changes nothing.
# Both are read only with --telegram. Setup: README > Telegram delivery > Telegram setup
# Bot token from @BotFather (/newbot). Keep it secret; never commit it.
# TELEGRAM_BOT_TOKEN=
# Your own numeric chat ID (positive number; groups and channels are not supported)
# TELEGRAM_CHAT_ID=

# --- Email delivery (optional, off by default) ---
# Every line below is commented out, so copying this file to .env changes nothing.
# Read only with --email. Sent through the same Gmail MCP server and login (no SMTP).
# Comma-separated bare addresses, at most 10; every recipient sees the others in To.
# EMAIL_TO=you@example.com
# Seconds to wait for Gmail to accept the send (10-600, default 90)
# EMAIL_SEND_TIMEOUT=90
