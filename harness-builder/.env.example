# harness-builder settings. Copy to `.env` in the directory you run `harness`
# from. Real environment variables win over this file; empty values count as
# unset. The file is never copied into os.environ. Never commit a real key.

# API key for OpenRouter. Needed for live runs only; offline runs (fake LLM,
# `uv run pytest`) never need it.
OPENROUTER_API_KEY=

# Default model id, for example `openai/gpt-4o-mini`. A spec's own `model` wins.
HARNESS_MODEL=

# Where traces are written. Default: .harness/traces
HARNESS_TRACE_DIR=

# Skills root (the directory that holds `.agents/`) when neither the spec nor
# `--skills-root` sets one. Default: the nearest pyproject.toml above the CWD.
# Read from the real environment only, not from this file. Keep it outside any
# harness directory that has docker module tools (see docs/skills.md).
HARNESS_SKILLS_ROOT=

# Sandbox image tag. Default: the content-hash tag harness-builder-sandbox:<hash>
# that `harness doctor` prints.
HARNESS_DOCKER_IMAGE=

# Test switch, not a setting: `HARNESS_LIVE=1 uv run pytest` runs the live-LLM
# tests (needs OPENROUTER_API_KEY and HARNESS_MODEL). Set it in the shell.
# HARNESS_LIVE=1
